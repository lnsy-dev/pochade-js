# Development files
node_modules/
.env*
!.env.example
package-lock.json
prompts/
assets/
dist/

# Version control
.git/
.gitignore

# Documentation

# Source files are included, but these are not needed
.DS_Store
*.log

# Tests and test configuration (not needed in published package)
tests/
playwright.config.js
test-results/
playwright-report/
playwright/.cache/

# WebAssembly build tools (pre-built artifacts in pkg/ are included)
src/wasm/cpp/Makefile
src/wasm/rust/**/Cargo.toml
src/wasm/rust/**/Cargo.lock
src/wasm/rust/**/src/
src/wasm/rust/**/target/

# Package lock should be regenerated by end user
package-lock.json
